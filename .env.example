# Environment Variables Configuration
# Copy this file to .env and change the values for production

# Secret key for encrypting sessions and cookies (generate a random 32+ character string)
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production

# Server Port (default 5000, cloud providers like Render/Heroku set this automatically)
PORT=5000

# Environment mode: production or development
FLASK_ENV=production
